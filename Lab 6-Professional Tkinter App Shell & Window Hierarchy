def create_card(parent, title, value, color):

    card = tk.Frame(
        parent,
        bg=WHITE,
        highlightbackground="#E7E5EF",
        highlightthickness=1
    )

    card.pack(
        side="left",
        fill="both",
        expand=True,
        padx=7,
        ipady=15
    )

    tk.Label(
        card,
        text=title,
        font=("Arial", 10, "bold"),
        bg=WHITE,
        fg=GRAY
    ).pack(anchor="w", padx=18, pady=(18, 8))

    value_label = tk.Label(
        card,
        text=value,
        font=("Arial", 27, "bold"),
        bg=WHITE,
        fg=color
    )

    value_label.pack(anchor="w", padx=18, pady=(0, 15))

    return value_label


