students = []


def create_button(parent, text, command, bg=PRIMARY, fg=WHITE,
                  width=18, font=("Arial", 10, "bold")):

    return tk.Button(
        parent,
        text=text,
        command=command,
        bg=bg,
        fg=fg,
        activebackground=PRIMARY_HOVER,
        activeforeground=WHITE,
        font=font,
        width=width,
        relief="flat",
        bd=0,
        cursor="hand2",
        pady=10
    )


def update_dashboard():

    total_students.config(text=str(len(students)))

    total_courses.config(
        text=str(len(set(s["course"] for s in students)))
    )

    recent_students.config(text=str(len(students)))


def open_new_window():

    new_window = tk.Toplevel(root)

    new_window.title("Add New Student")
    new_window.geometry("500x530")
    new_window.resizable(False, False)
    new_window.configure(bg=BG)
    new_window.transient(root)

    # Center the child window
    new_window.update_idletasks()
    x = root.winfo_x() + (root.winfo_width() - 500) // 2
    y = root.winfo_y() + (root.winfo_height() - 530) // 2
    new_window.geometry(f"+{x}+{y}")

    # Header
    header = tk.Frame(new_window, bg=SIDEBAR, height=110)
    header.pack(fill="x")

    tk.Label(
        header,
        text="ADD NEW STUDENT",
        font=("Arial", 19, "bold"),
        bg=SIDEBAR,
        fg=WHITE
    ).pack(pady=(25, 5))

    tk.Label(
        header,
        text="Enter the student's information below",
        font=("Arial", 10),
        bg=SIDEBAR,
        fg="#C9C2E4"
    ).pack()

    # Form container
    form = tk.Frame(new_window, bg=WHITE, padx=35, pady=20)
    form.pack(fill="both", expand=True, padx=20, pady=20)

    # Student Name
    tk.Label(
        form,
        text="Student Name",
        font=("Arial", 10, "bold"),
        bg=WHITE,
        fg=DARK
    ).pack(anchor="w", pady=(5, 5))

    name_entry = tk.Entry(
        form,
        font=("Arial", 11),
        relief="solid",
        bd=1
    )
    name_entry.pack(fill="x", ipady=8)

    # Student ID
    tk.Label(
        form,
        text="Student ID",
        font=("Arial", 10, "bold"),
        bg=WHITE,
        fg=DARK
    ).pack(anchor="w", pady=(18, 5))

    id_entry = tk.Entry(
        form,
        font=("Arial", 11),
        relief="solid",
        bd=1
    )
    id_entry.pack(fill="x", ipady=8)

    # Course
    tk.Label(
        form,
        text="Course",
        font=("Arial", 10, "bold"),
        bg=WHITE,
        fg=DARK
    ).pack(anchor="w", pady=(18, 5))

    course_entry = tk.Entry(
        form,
        font=("Arial", 11),
        relief="solid",
        bd=1
    )
    course_entry.pack(fill="x", ipady=8)

    # Save Function
    def save_student():

        name = name_entry.get().strip()
        student_id = id_entry.get().strip()
        course = course_entry.get().strip()

        if name == "" or student_id == "" or course == "":
            messagebox.showwarning(
                "Incomplete Information",
                "Please fill in all fields.",
                parent=new_window
            )
            return

        # Check for duplicate student ID
        for student in students:
            if student["id"] == student_id:
                messagebox.showwarning(
                    "Duplicate ID",
                    "This Student ID already exists.",
                    parent=new_window
                )
                return

        # Save student information
        students.append({
            "name": name,
            "id": student_id,
            "course": course
        })

        update_dashboard()

        messagebox.showinfo(
            "Success",
            "Student information saved successfully!",
            parent=new_window
        )

        new_window.destroy()

    # Buttons
    create_button(
        form,
        "SAVE STUDENT",
        save_student,
        width=25
    ).pack(pady=(25, 8))

    create_button(
        form,
        "CANCEL",
        new_window.destroy,
        bg="#E9E8EF",
        fg=DARK,
        width=25
    ).pack()


